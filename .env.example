# LLM API
OPENAI_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CLASSIFIER_MODEL=deepseek-v4-flash
GENERATOR_MODEL=deepseek-v4-flash
ADAPTER_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=
LANGCHAIN_API_KEY=

# LangSmith (用于tracing)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=Agent-LangGraphService-local
LANGSMITH_API_KEY=
LANGSMITH_WORKSPACE=Personal

# RAG (阿里云 DashScope Embedding)
RAG_ZHIPU_API_KEY=
RAG_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
RAG_EMBEDDING_DIMENSION=1024

# 电商后端API (Mock)
ORDER_API_URL=
INVENTORY_API_URL=
PAYMENT_API_URL=

# 数据库 (持久化检查点)
DATABASE_URL=

# 观测
TRACE_SAMPLE_RATE=0.1
